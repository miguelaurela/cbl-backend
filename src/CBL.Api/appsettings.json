{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": ""
  },
  "ConnectionStrings": {
    "Cbl": ""
  },
  "Jwt": {
    "Issuer": "cbl-api",
    "Audience": "cbl-clients",
    "LifetimeMinutes": 10
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "GlobalPerMinute": 100,
    "LoginPerMinute": 20
  }
}
